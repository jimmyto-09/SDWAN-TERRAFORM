            "metadata": [
              {
                "annotations": {
                  "cni.projectcalico.org/containerID": "1e204dee9278d289cc3018170965d6cd18c8d0a342b8ce92c60a698d540ff92c",
                  "cni.projectcalico.org/podIP": "10.1.138.57/32",
                  "cni.projectcalico.org/podIPs": "10.1.138.57/32",
                  "k8s.v1.cni.cncf.io/network-status": "[{\n    \"name\": \"k8s-pod-network\",\n    \"ips\": [\n        \"10.1.138.57\"\n    ],\n    \"default\": true,\n    \"dns\": {}\n},{\n    \"name\": \"rdsv/mplswan\",\n    \"interface\": \"net1\",\n    \"mac\": \"c6:a5:d9:2b:8b:e6\",\n    \"dns\": {}\n}]",
                  "k8s.v1.cni.cncf.io/networks": "[{\"interface\":\"net1\",\"name\":\"mplswan\"}]"
                },
                "generate_name": "",
                "generation": 0,
                "labels": {
