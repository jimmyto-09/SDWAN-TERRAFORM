      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "prometheus_config",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "prometheus.yml": "global:\n  scrape_interval: 15s\n  evaluation_interval: 15s\n\nscrape_configs:\n  - job_name: \"kubernetes-pods\"\n    kubernetes_sd_configs:\n      - role: pod\n    relabel_configs:\n      - source_labels: [\"__meta_kubernetes_namespace\"]\n        regex: \"rdsv\"\n        action: \"keep\"\n      - source_labels: [\"__meta_kubernetes_pod_label_k8s_app\"]\n        regex: \"vnf-.*\"\n        action: \"keep\"\n      - source_labels: [\"__meta_kubernetes_pod_ip\"]\n        target_label: \"__address__\"\n        replacement: \"$1:9100\"\n\n      \n\n  - job_name: \"prometheus\"\n    static_configs:\n      - targets: [\"localhost:9090\"]\n"
            },
            "id": "monitoring/prometheus-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": null,
                "name": "prometheus-config",
                "namespace": "monitoring",
                "resource_version": "269411",
                "uid": "a5bc0145-6d83-4b62-a428-6d4f3e847589"
              }
            ]
          },
